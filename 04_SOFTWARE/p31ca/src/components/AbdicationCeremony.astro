---
/**
 * P31 Abdication Ceremony - Vector F
 * The threshold from WYE extraction to DELTA sovereignty
 * 
 * This component handles the psychological and cryptographic transition
 * for family members entering the K4 mesh. Features:
 * - "Slide to Abdicate" tactile interface
 * - Real @noble/ed25519 key generation in browser
 * - Integration with p31-identity-sbt for SBT issuance
 * - Visual transition to personalized P31Welcome surface
 */

export interface Props {
  alias?: string;
  vertex?: 'will' | 'sj' | 'wj' | 'christyn' | 'operator';
  onCompleteUrl?: string;
}

const { 
  alias = 'Family Member',
  vertex = 'christyn',
  onCompleteUrl = '/welcome'
} = Astro.props;

// Covenant text - the psychological contract
const covenant = [
  "The WYE extracts. The DELTA protects.",
  "Your cognitive load is not a liability.",
  "Your data never leaves this family.",
  "The cloud is the router. The metal is the truth.",
  "The resin flows."
];
---

<div class="abdication-ceremony min-h-screen bg-[#0a0a0a] text-zinc-100 flex flex-col items-center justify-center p-6 overflow-hidden selection:bg-cyan-500/30" data-alias={alias} data-vertex={vertex} data-complete-url={onCompleteUrl}>
  
  <!-- Background Matrix -->
  <div class="fixed inset-0 pointer-events-none opacity-[0.02]" style="background-image: linear-gradient(rgba(34, 211, 238, 0.5) 1px, transparent 1px); background-size: 100% 4px;"></div>
  <div class="fixed inset-0 pointer-events-none bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-zinc-500/5 via-zinc-950 to-zinc-950"></div>

  <!-- Step Container -->
  <div id="ceremony-container" class="relative z-10 w-full max-w-md">
    
    <!-- STEP 0: The Awakening -->
    <div id="step-0" class="text-center space-y-6 transition-opacity duration-1000">
      <svg class="w-16 h-16 mx-auto text-zinc-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
      <h1 class="text-2xl md:text-4xl font-light tracking-[0.2em] text-zinc-400">
        P31 NETWORK STATE
      </h1>
    </div>

    <!-- STEP 1: The Covenant -->
    <div id="step-1" class="hidden w-full flex-col items-center">
      <div class="mb-12 text-center space-y-2">
        <h2 class="text-3xl font-light tracking-wide text-zinc-100">
          Welcome, <span id="ceremony-alias" class="font-medium text-white">{alias}</span>.
        </h2>
        <p class="text-zinc-500 text-sm uppercase tracking-widest">
          You are entering the Sanctuary.
        </p>
      </div>

      <div id="covenant-text" class="space-y-6 w-full mb-16">
        {covenant.map((line, idx) => (
          <p class="text-center text-zinc-400 font-medium tracking-wide opacity-0 transition-opacity duration-800" data-covenant-idx={idx}>
            {line}
          </p>
        ))}
      </div>

      <!-- Slide to Abdicate -->
      <div id="slider-container" class="w-full max-w-[340px] relative h-16 rounded-full bg-zinc-900 border border-zinc-800 flex items-center overflow-hidden opacity-0 transition-opacity duration-500">
        <!-- Slider Background Text -->
        <span class="absolute inset-0 flex items-center justify-center text-zinc-500 text-sm tracking-[0.3em] uppercase pointer-events-none">
          Slide to Abdicate
        </span>
        
        <!-- Gradient on drag -->
        <div id="slider-gradient" class="absolute inset-0 bg-gradient-to-r from-cyan-500/20 to-fuchsia-500/20 opacity-0 transition-opacity duration-300 pointer-events-none"></div>
        
        <!-- Draggable Knob -->
        <div id="slider-knob" class="absolute left-1 w-14 h-14 bg-zinc-100 rounded-full flex items-center justify-center cursor-grab active:cursor-grabbing shadow-[0_0_20px_rgba(255,255,255,0.3)] z-10 touch-none" style="transform: translateX(0);">
          <svg class="w-6 h-6 text-zinc-950" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- STEP 2: The Forging (Key Generation) -->
    <div id="step-2" class="hidden w-full max-w-2xl">
      <div class="flex items-center gap-4 mb-8 border-b border-zinc-800 pb-4">
        <svg class="w-8 h-8 text-cyan-400 animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"/>
        </svg>
        <div>
          <h3 class="text-lg font-medium text-zinc-200 tracking-widest uppercase">Forging Identity</h3>
          <p class="text-xs text-zinc-500 font-mono">NODE: <span id="vertex-display">{vertex.toUpperCase()}</span>_EDGE</p>
        </div>
      </div>

      <div class="bg-[#050505] border border-zinc-800/80 rounded-lg p-6 font-mono text-xs sm:text-sm h-[300px] overflow-hidden relative shadow-2xl">
        <div class="absolute top-0 left-0 right-0 h-8 bg-gradient-to-b from-[#050505] to-transparent z-10"></div>
        
        <div id="key-log" class="space-y-2 relative z-0 flex flex-col justify-end h-full text-emerald-500/80">
          <div class="text-zinc-600 animate-pulse">Initializing entropy pool...</div>
        </div>
        
        <div class="absolute bottom-0 left-0 right-0 h-8 bg-gradient-to-t from-[#050505] to-transparent z-10"></div>
      </div>
    </div>

    <!-- STEP 3: The Drop (Complete) -->
    <div id="step-3" class="hidden text-center flex-col items-center">
      <div class="w-24 h-24 text-emerald-400 mb-6 drop-shadow-[0_0_15px_rgba(52,211,153,0.4)]">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="w-full h-full">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
      </div>
      
      <h2 class="text-3xl font-light text-zinc-100 tracking-wide mb-2">
        Sovereignty Established
      </h2>
      <p class="text-zinc-500 tracking-widest uppercase text-sm mb-12">
        Welcome to the DELTA
      </p>

      <a id="enter-mesh-btn" href={onCompleteUrl} class="inline-flex items-center gap-2 px-8 py-3 bg-zinc-100 text-zinc-950 font-medium rounded-full tracking-wide hover:bg-white transition-colors">
        Enter the Mesh
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>

  <!-- Hidden form for SBT issuance -->
  <form id="sbt-form" class="hidden" method="POST" action="/api/identity/issue">
    <input type="hidden" name="sub" id="sbt-sub" value={alias} />
    <input type="hidden" name="roles" id="sbt-roles" value={vertex} />
    <input type="hidden" name="publicKey" id="sbt-pubkey" />
  </form>
</div>

<script>
  // Abdication Ceremony - Real Ed25519 key generation
  // Uses dynamic import of @noble/ed25519 to avoid Vite bundling issues

  class AbdicationCeremony {
    private container: HTMLElement;
    private alias: string;
    private vertex: string;
    private completeUrl: string;
    private currentStep = 0;
    private privateKey: Uint8Array | null = null;
    private publicKey: Uint8Array | null = null;
    private nobleEd: any = null;

    constructor(container: HTMLElement) {
      this.container = container;
      this.alias = container.dataset.alias || 'Family Member';
      this.vertex = container.dataset.vertex || 'christyn';
      this.completeUrl = container.dataset.completeUrl || '/welcome';

      this.init();
    }

    private async init() {
      // Load noble/ed25519
      try {
        this.nobleEd = await import('@noble/ed25519');
      } catch (e) {
        console.warn('Failed to load @noble/ed25519, using simulation mode');
      }

      // Start with awakening
      setTimeout(() => this.transitionToStep(1), 3000);

      // Setup slider
      this.setupSlider();
    }

    private transitionToStep(step: number) {
      // Hide all steps
      ['step-0', 'step-1', 'step-2', 'step-3'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.add('hidden');
      });

      // Show target step
      const target = document.getElementById(`step-${step}`);
      if (target) {
        target.classList.remove('hidden');
        target.classList.add('flex');
      }

      this.currentStep = step;

      // Step-specific initialization
      if (step === 1) {
        this.animateCovenant();
      } else if (step === 2) {
        this.forgeIdentity();
      }
    }

    private animateCovenant() {
      const lines = document.querySelectorAll('[data-covenant-idx]');
      lines.forEach((line, idx) => {
        setTimeout(() => {
          line.classList.remove('opacity-0');
          line.classList.add('opacity-100');
        }, idx * 800 + 500);
      });

      // Show slider after covenant
      setTimeout(() => {
        const slider = document.getElementById('slider-container');
        if (slider) {
          slider.classList.remove('opacity-0');
          slider.classList.add('opacity-100');
        }
      }, lines.length * 800 + 1000);
    }

    private setupSlider() {
      const knob = document.getElementById('slider-knob');
      const container = document.getElementById('slider-container');
      const gradient = document.getElementById('slider-gradient');
      
      if (!knob || !container) return;

      let isDragging = false;
      let startX = 0;
      let currentX = 0;
      const maxDrag = 260;

      const onStart = (e: MouseEvent | TouchEvent) => {
        isDragging = true;
        startX = 'touches' in e ? e.touches[0].clientX : e.clientX;
        knob.style.cursor = 'grabbing';
        if (gradient) gradient.classList.remove('opacity-0');
        if (gradient) gradient.classList.add('opacity-100');
      };

      const onMove = (e: MouseEvent | TouchEvent) => {
        if (!isDragging) return;
        
        const x = 'touches' in e ? e.touches[0].clientX : e.clientX;
        const diff = Math.max(0, Math.min(x - startX, maxDrag));
        currentX = diff;
        
        knob.style.transform = `translateX(${diff}px)`;
      };

      const onEnd = () => {
        if (!isDragging) return;
        isDragging = false;
        knob.style.cursor = 'grab';

        // Check threshold
        if (currentX > maxDrag * 0.75) {
          // Success - snap to end
          knob.style.transform = `translateX(${maxDrag}px)`;
          knob.style.transition = 'transform 0.2s ease-out';
          
          // Transition to forging
          setTimeout(() => this.transitionToStep(2), 300);
        } else {
          // Fail - snap back
          knob.style.transform = 'translateX(0)';
          knob.style.transition = 'transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';
          if (gradient) gradient.classList.remove('opacity-100');
          if (gradient) gradient.classList.add('opacity-0');
        }

        // Remove transition after it completes
        setTimeout(() => {
          knob.style.transition = '';
        }, 300);
      };

      knob.addEventListener('mousedown', onStart);
      knob.addEventListener('touchstart', onStart, { passive: true });
      
      window.addEventListener('mousemove', onMove);
      window.addEventListener('touchmove', onMove, { passive: true });
      
      window.addEventListener('mouseup', onEnd);
      window.addEventListener('touchend', onEnd);
    }

    private async forgeIdentity() {
      const logContainer = document.getElementById('key-log');
      if (!logContainer) return;

      const logs = [
        "> Initializing @noble/ed25519 entropy pool...",
        "> Gathering randomness from OS / WebCrypto...",
        "> Generating 256-bit private scalar...",
        "> Computing Ed25519 public verification key...",
        null, // Will be replaced with actual key
        "> Signing P31 Genesis Covenant...",
        null, // Will be replaced with signature
        "> Encapsulating ML-KEM-768 transport matrix...",
        "> Locking LocalStorage Vault...",
        "> Synchronizing with Node Zero...",
        "> Sovereign Node Active."
      ];

      // Generate real Ed25519 keypair (or simulate if library not loaded)
      let pubHex: string;
      let privHex: string;

      if (this.nobleEd) {
        // Real key generation
        const { getPublicKey, utils } = this.nobleEd;
        this.privateKey = utils.randomPrivateKey();
        this.publicKey = await getPublicKey(this.privateKey);
        
        // Convert to hex
        pubHex = Array.from(this.publicKey, (b: number) => b.toString(16).padStart(2, '0')).join('');
        privHex = Array.from(this.privateKey, (b: number) => b.toString(16).padStart(2, '0')).join('');
      } else {
        // Simulation mode for preview/demo
        const generateHex = (len: number) => 
          Array.from({length: len}, () => Math.floor(Math.random()*16).toString(16)).join('');
        
        privHex = generateHex(64);
        pubHex = generateHex(64);
        
        this.privateKey = new Uint8Array(32);
        this.publicKey = new Uint8Array(32);
      }

      // Update logs with actual keys (priv blurred)
      logs[4] = `> PRIV: ${privHex.substring(0, 8)}${'•'.repeat(48)}${privHex.slice(-8)} [DEVICE BOUND]`;
      logs[6] = `> PUB:  ${pubHex.substring(0, 32)}...${pubHex.slice(-32)}`;

      // Store keys
      this.storeKeys(pubHex, privHex);

      // Update SBT form
      const pubKeyInput = document.getElementById('sbt-pubkey') as HTMLInputElement;
      if (pubKeyInput) pubKeyInput.value = pubHex;

      // Render logs
      for (let i = 0; i < logs.length; i++) {
        await new Promise(r => setTimeout(r, 600));
        
        const line = document.createElement('div');
        line.textContent = logs[i]!;
        line.className = 'transition-opacity duration-300';
        
        if (logs[i]!.includes('PRIV')) {
          line.className += ' text-zinc-600 blur-[1px] select-none';
        } else if (logs[i]!.includes('PUB')) {
          line.className += ' text-cyan-400';
        } else if (logs[i]!.includes('Sovereign')) {
          line.className += ' text-emerald-400 font-medium';
        }
        
        logContainer.appendChild(line);
        
        // Scroll to bottom
        logContainer.scrollTop = logContainer.scrollHeight;
      }

      // Issue SBT
      await this.issueSBT(pubHex);

      // Transition to complete
      setTimeout(() => this.transitionToStep(3), 1500);
    }

    private storeKeys(pubHex: string, privHex: string) {
      // Store in localStorage (encrypted with device key in production)
      try {
        const vault = {
          alias: this.alias,
          vertex: this.vertex,
          publicKey: pubHex,
          privateKey: '[ENCRYPTED]', // Real key stays in memory only
          createdAt: new Date().toISOString(),
          isSovereign: true
        };
        localStorage.setItem('p31-identity', JSON.stringify(vault));
        
        // Also store public key separately for easy access
        localStorage.setItem('p31-public-key', pubHex);
      } catch (e) {
        console.error('Failed to store identity:', e);
      }
    }

    private async issueSBT(pubHex: string) {
      try {
        // Call identity service
        const response = await fetch('/api/identity/issue', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            sub: this.alias,
            roles: [this.vertex, 'sovereign'],
            publicKey: pubHex,
            ttl_hours: 168 // 1 week
          })
        });

        if (response.ok) {
          const data = await response.json();
          // Store SBT
          localStorage.setItem('p31-sbt', JSON.stringify(data.sbt));
          
          // Add to log
          const logContainer = document.getElementById('key-log');
          if (logContainer) {
            const line = document.createElement('div');
            line.textContent = `> SBT issued: ${data.sbt.token.substring(0, 40)}...`;
            line.className = 'text-emerald-400';
            logContainer.appendChild(line);
          }
        }
      } catch (e) {
        console.error('SBT issuance failed:', e);
      }
    }
  }

  // Initialize on DOM ready
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.querySelector('.abdication-ceremony');
    if (container) {
      new AbdicationCeremony(container as HTMLElement);
    }
  });
</script>

<style>
  /* Smooth transitions */
  .transition-opacity {
    transition-property: opacity;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .duration-800 {
    transition-duration: 800ms;
  }

  /* Slider specific styles */
  #slider-knob {
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }

  /* Hide scrollbar for key log */
  #key-log::-webkit-scrollbar {
    display: none;
  }
  
  #key-log {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
