---
import AppShell from '../layouts/AppShell.astro';
import BentoGrid from '../components/BentoGrid.astro';
---

<AppShell
  title="P31 Constellation | 100+ App Ecosystem"
  description="A 104-app technical ecosystem for decentralized family coordination. Edge-native infrastructure with zero surveillance."
  routeName="home"
>

  <!-- Main content container: explicit min-height prevents CLS during hydration -->
  <div class="space-y-12 pb-24" style="min-height: 900px; contain: layout style;">
    <!-- Hero Section: Critical LCP element - optimized for fast paint -->
    <div class="p31-hero-critical flex flex-col gap-6 text-center max-w-4xl mx-auto pt-8"
         style="min-height: 280px; contain: layout style paint;">
      <!-- Status badge: render immediately, no animation on first paint -->
      <div class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-full bg-zinc-900/80 border border-zinc-800 text-sm text-zinc-400 mx-auto">
        <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.8)]" id="status-dot"></span>
        <span class="font-mono text-emerald-400">v2.0.0-rc.4 LIVE</span>
        <span class="mx-2 text-zinc-700">|</span>
        <span>100+ Applications Initialized</span>
      </div>

      <!-- Main heading: Largest Contentful Paint target -->
      <h1 class="text-5xl md:text-7xl font-extrabold text-white tracking-tight" style="content-visibility: auto;">
        P31 Constellation
      </h1>
      <p class="text-xl text-zinc-400 font-light max-w-2xl mx-auto leading-relaxed">
        A 104-app technical ecosystem for decentralized family coordination.
        Edge-native infrastructure with zero surveillance.
      </p>
    </div>

    <!-- The 100+ App Bento Grid Constellation -->
    <BentoGrid />

  </div>

  <!-- Defer animation until after LCP -->
  <script is:inline>
    // Add pulse animation after LCP to avoid animation jank during paint
    if ('requestIdleCallback' in window) {
      requestIdleCallback(function() {
        var dot = document.getElementById('status-dot');
        if (dot) dot.classList.add('animate-pulse');
      }, { timeout: 2000 });
    } else {
      setTimeout(function() {
        var dot = document.getElementById('status-dot');
        if (dot) dot.classList.add('animate-pulse');
      }, 2000);
    }
  </script>

</AppShell>
