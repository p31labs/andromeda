# P31 Environment Template
# Copy to .env and fill in values (never commit .env)

# App Config
VITE_APP_ID=your-app-id
VITE_APP_VERSION=1.0.0
VITE_USER_ID=your-user@p31.mesh

# API Endpoints
VITE_IDENTITY_URL=https://p31-identity-sbt.p31ca.workers.dev
VITE_STATE_URL=https://p31-state.p31ca.workers.dev
VITE_VOICE_URL=https://voice.phosphorus31.org/voice
VITE_BUG_REPORT_URL=https://bug-reports.p31ca.workers.dev

# Mesh Sync
VITE_SYNC_INTERVAL=30000
VITE_ENABLE_OFFLINE=true
VITE_PGLITE_STORAGE=opfs

# Security
VITE_SBT_TTL=86400000
VITE_ENCRYPTION_KEY=your-encryption-key

# Optional: Analytics/Monitoring (disabled by default)
# VITE_TELEMETRY_ENDPOINT=
