{
  "name": "p31-copilot",
  "displayName": "P31 Copilot",
  "description": "The sovereign edge in your IDE.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.82.0"
  },
  "activationEvents": [
    "onView:p31.lawDashboard"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "p31.lawDashboard",
          "name": "P31 Law Dashboard"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.82.0",
    "@types/node": "^20.11.17",
    "typescript": "^5.3.3"
  }
}
