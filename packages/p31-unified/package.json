{
  "name": "@p31/unified",
  "version": "1.0.0",
  "type": "module",
  "description": "P31 Arcade unified layer - cross-game identity, spoons, and skill bridges",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./identity": {
      "import": "./dist/identity/index.js",
      "types": "./dist/identity/index.d.ts"
    },
    "./spoons": {
      "import": "./dist/spoons/index.js",
      "types": "./dist/spoons/index.d.ts"
    },
    "./bridge": {
      "import": "./dist/bridge/index.js",
      "types": "./dist/bridge/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "keywords": ["p31", "arcade", "unified", "identity", "spoons"],
  "license": "MIT"
}
