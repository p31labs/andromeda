# P31 Middleware Configuration
# Copy this file to .env and fill in your actual credentials

# Ko-fi Configuration
KOFI_VERIFICATION_TOKEN=your_kofi_verification_token_here
KOFI_WEBHOOK_SECRET=your_kofi_webhook_secret_here
KOFI_API_TOKEN=your_kofi_api_token_here

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=p31labs/andromeda
GITHUB_OWNER=p31labs

# Discord Integration
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_ROLE_SUPPORTER_ID=your_discord_supporter_role_id_here
DISCORD_ROLE_NODE_ID=your_discord_node_role_id_here
DISCORD_ROLE_GUILD_LEADER_ID=your_discord_guild_leader_role_id_here
DISCORD_ROLE_CORE_TEAM_ID=your_discord_core_team_role_id_here

# Zenodo Configuration
ZENODO_API_TOKEN=your_zenodo_api_token_here
ZENODO_SANDBOX=false

# Upstash Redis Configuration
UPSTASH_REDIS_URL=your_upstash_redis_url_here
UPSTASH_REDIS_TOKEN=your_upstash_redis_token_here

# IPFS Configuration
IPFS_GATEWAY=https://cloudflare-ipfs.com
ENS_DOMAIN=andromeda.p31.eth

# Environment
NODE_ENV=production
