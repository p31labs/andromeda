# ═════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
# P31 Labs — Crypto Processor Environment Configuration
#
# This file controls ALL wallet addresses, API keys, and endpoints.
# Edit values here WITHOUT rebuilding containers.
# Restart with: ./deploy-crypto.sh restart
# ═════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

# ─── Network ───────────────────────────────────────────────────────────
# Use these for local testing, then switch to real domains for production.
# Examples:
#   SATSALE_DOMAIN=satsale.p31ca.org
#   SATSALE_DOMAIN=192.168.1.50  (no TLS — use only for testing)
SATSALE_DOMAIN=satsale.p31ca.org
PAYLIX_DOMAIN=paylix.p31ca.org

# ─── BTCPay Server (Bitcoin/Lightning) ─────────────────────────────────
# Connection mode: choose ONE

# Option A: Full node with RPC (requires Bitcoin Core running)
# Uncomment these and comment out the explorer section below if using full node
# BTCPAY_RPC_USER=bitcoin
# BTCPAY_RPC_PASSWORD=your_rpc_password_here
# BTCPAY_RPC_HOST=bitcoin  # container name or IP
# BTCPAY_RPC_PORT=8332

# Option B: Explorer-only (uses block explorer APIs, no full node required)
# Recommended for simplicity - uses NBXplorer by default
BTCPAY_NETWORK=testnet  # Use testnet for safe testing, change to mainnet for production
BTCPAY_BIND=0.0.0.0
BTCPAY_PORT=8080
BTCPAY_API_PORT=8081
# BTCPAY_API_KEY will be generated after first start - retrieve from UI
# Pairing → API Keys → Create new key (Server Daemon permission)

# Store configuration (obtain from BTCPay UI after creating a store)
# Login to BTCPay, create store (e.g., "P31 Labs Donations"), get Store ID
BTCPAY_STORE_ID=your_store_id_here
BTCPAY_SERVER_URL=http://btcpay:8080  # Internal Docker network URL

# Webhook secret for donation verification (used by validatePayPalWebhookSignature)
# Generate: openssl rand -hex 32
SATSALE_WEBHOOK_SECRET=replace_with_random_64_hex_chars

# ─── Paylix (Multi-chain EVM) ──────────────────────────────────────────
# Wallet: provide EITHER mnemonic OR private key (not both)
# Get from MetaMask, Ledger, Trezor, or other HD wallet
# NEVER commit these to version control!
PAYLIX_MNEMONIC="replace with your twelve or twenty four word mnemonic"
# PAYLIX_PRIVATE_KEY=replace_with_64_char_hex_no_0x

# Networks (comma-separated chain IDs)
# DEFAULT SET TO TESTNETS FOR SAFE TESTING:
#   137 = Polygon Mumbai (testnet)
#   80001 = Arbitrum Goerli (testnet) 
#   80002 = Optimism Goerli (testnet)
#   421614 = Arbitrum Nova testnet
#   420 = Optimism Goerli (alternative)
#   84532 = Base Goerli (testnet)
#   4002 = Fantom testnet
# For production, use: 1,137,56,42161,10,8453,250 (Mainnet: ETH, Polygon, BSC, Arb, Opt, Base, Fantom)
PAYLIX_CHAINS=137,80001,80002,421614,420,84532,4002

# Currencies (comma-separated)
PAYLIX_CURRENCIES=USDC,USDT

# Webhook secret for donation verification
# Generate: openssl rand -hex 32
PAYLIX_WEBHOOK_SECRET=replace_with_random_64_hex_chars

# ─── Postgres (shared) ─────────────────────────────────────────────────
POSTGRES_DB=paylix
POSTGRES_USER=paylix
POSTGRES_PASSWORD=replace_with_secure_password

# ─── donate-api Worker (Cloudflare) ────────────────────────────────────
# These must match the secrets set via: npx wrangler secret put <NAME>
# Set these AFTER deploying the worker below.
DONATE_API_URL=https://donate-api.phosphorus31.org

# Webhook paths (should match worker routes)
SATSALE_WEBHOOK_PATH=/satsale/webhook
PAYLIX_WEBHOOK_PATH=/paylix/webhook

# ─── Optional: Monitoring ───────────────────────────────────────────────
# PROMETHEUS_ENABLED=false
# GRAFANA_ENABLED=false

# ─── Generated Secrets (do not edit manually) ───────────────────────────
# These are populated by ./deploy-crypto.sh init
# BTCPAY_API_KEY=auto-generated-from-ui