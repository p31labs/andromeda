{
  "name": "paylix",
  "version": "1.0.0",
  "private": true,
  "description": "Paylix — Multi-chain EVM payment processor for P31 Labs",
  "workspaces": [
    "apps/web",
    "packages/indexer",
    "packages/shared"
  ],
  "scripts": {
    "dev": "pnpm --filter ./apps/web dev",
    "build": "pnpm --filter ./apps/web build && pnpm --filter ./indexer build",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
