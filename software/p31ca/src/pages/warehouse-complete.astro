---
// Warehouse Complete — Scanner + Dashboard + Admin
// All-in-one warehouse management surface
// Route: /warehouse-complete

import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Warehouse Manager';
const description = 'Complete inventory management for used furniture warehouse';
---

<BaseLayout title={title} description={description}>
  <head slot="head">
    <link rel="manifest" href="/warehouse-manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Warehouse" />
    <meta name="theme-color" content="#0f1115" />
  </head>

  <div id="warehouse-app" style="min-height: 100vh; background: #0f1115;">
    <!-- Tab Navigation -->
    <nav style="
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      display: flex;
      background: #161920;
      border-top: 1px solid #2a2e35;
      z-index: 1000;
    ">
      <button class="tab-btn active" data-tab="scan" style="
        flex: 1;
        padding: 16px;
        background: transparent;
        border: none;
        color: #5DCAA5;
        font-size: 14px;
        cursor: pointer;
      ">📷 Scan</button>
      <button class="tab-btn" data-tab="dashboard" style="
        flex: 1;
        padding: 16px;
        background: transparent;
        border: none;
        color: #666;
        font-size: 14px;
        cursor: pointer;
      ">📊 Dashboard</button>
      <button class="tab-btn" data-tab="admin" style="
        flex: 1;
        padding: 16px;
        background: transparent;
        border: none;
        color: #666;
        font-size: 14px;
        cursor: pointer;
      ">⚙️ Admin</button>
    </nav>

    <!-- Tab Content -->
    <div id="tab-scan" class="tab-content" style="padding-bottom: 60px;">
      <div id="scanner-root" style="height: 100vh;"></div>
    </div>

    <div id="tab-dashboard" class="tab-content" style="display: none; padding: 20px; padding-bottom: 80px;">
      <div id="dashboard-root"></div>
    </div>

    <div id="tab-admin" class="tab-content" style="display: none; padding: 20px; padding-bottom: 80px;">
      <div style="max-width: 600px; margin: 0 auto; color: #D8D6D0;">
        <h2 style="color: #5DCAA5; margin-bottom: 20px;">⚙️ Warehouse Admin</h2>

        <div style="
          background: #161920;
          border-radius: 12px;
          padding: 20px;
          margin-bottom: 16px;
        ">
          <h3 style="margin-top: 0;">🔖 QR Sticker Printing</h3>
          <p style="color: #999; font-size: 14px;">Generate thermal labels for inventory</p>
          <a href="/warehouse-print" style="
            display: inline-block;
            margin-top: 12px;
            padding: 12px 24px;
            background: #5DCAA5;
            color: #0f1115;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
          ">Open Print Station →</a>
        </div>

        <div style="
          background: #161920;
          border-radius: 12px;
          padding: 20px;
          margin-bottom: 16px;
        ">
          <h3 style="margin-top: 0;">🔄 Manual Sync</h3>
          <p style="color: #999; font-size: 14px;">Push pending items to cloud</p>
          <button id="manual-sync" style="
            margin-top: 12px;
            padding: 12px 24px;
            background: #0f1115;
            color: #5DCAA5;
            border: 1px solid #5DCAA5;
            border-radius: 8px;
            cursor: pointer;
          ">Sync Now</button>
        </div>

        <div style="
          background: #161920;
          border-radius: 12px;
          padding: 20px;
        ">
          <h3 style="margin-top: 0; color: #cc6247;">⚠️ Danger Zone</h3>
          <button id="clear-data" style="
            padding: 12px 24px;
            background: #cc6247;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
          ">Clear All Local Data</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Tab switching
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.dataset.tab;

        // Update buttons
        document.querySelectorAll('.tab-btn').forEach(b => {
          b.classList.remove('active');
          b.style.color = '#666';
        });
        btn.classList.add('active');
        btn.style.color = '#5DCAA5';

        // Update content
        document.querySelectorAll('.tab-content').forEach(c => {
          c.style.display = 'none';
        });
        document.getElementById(`tab-${tab}`).style.display = 'block';
      });
    });

    // Load React components
    async function loadComponents() {
      try {
        const [{ ZeroTapWarehouse }, { WarehouseDashboard }, { getWarehouseDB, clearAllData }] = await Promise.all([
          import('../components/ZeroTapWarehouse.tsx'),
          import('../components/WarehouseDashboard.tsx'),
          import('../utils/pglite-warehouse.ts')
        ]);
        const React = await import('react');
        const { createRoot } = await import('react-dom/client');

        // Mount scanner
        const scannerRoot = createRoot(document.getElementById('scanner-root'));
        scannerRoot.render(
          React.createElement(ZeroTapWarehouse, {
            onSync: async (items) => {
              const response = await fetch('/api/state/sync', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items, source: 'warehouse-aj' }),
              });
              if (!response.ok) throw new Error('Sync failed');
            },
          })
        );

        // Mount dashboard
        const dashboardRoot = createRoot(document.getElementById('dashboard-root'));
        dashboardRoot.render(React.createElement(WarehouseDashboard));

        // Admin: Manual sync
        document.getElementById('manual-sync')?.addEventListener('click', async () => {
          const db = await getWarehouseDB();
          const { getUnsyncedItems, markItemsSynced } = await import('../utils/pglite-warehouse');
          const items = await getUnsyncedItems(db);

          if (items.length === 0) {
            alert('No items to sync');
            return;
          }

          try {
            const response = await fetch('/api/state/sync', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items, source: 'warehouse-aj' }),
            });

            if (response.ok) {
              await markItemsSynced(db, items.map(i => i.qrData));
              alert(`Synced ${items.length} items`);
            } else {
              alert('Sync failed');
            }
          } catch (err) {
            alert('Sync error: ' + err.message);
          }
        });

        // Admin: Clear data
        document.getElementById('clear-data')?.addEventListener('click', async () => {
          if (!confirm('⚠️ Delete all warehouse data? This cannot be undone.')) return;

          const db = await getWarehouseDB();
          await clearAllData(db);
          alert('All data cleared');
          location.reload();
        });

      } catch (err) {
        console.error('Failed to load warehouse:', err);
        document.getElementById('scanner-root').innerHTML = `
          <div style="padding: 40px; text-align: center; color: #cc6247;">
            Failed to load: ${err.message}
          </div>
        `;
      }
    }

    // Load when ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadComponents);
    } else {
      loadComponents();
    }
  </script>
</BaseLayout>
