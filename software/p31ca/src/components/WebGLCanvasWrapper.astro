---
/**
 * WebGLCanvasWrapper: Astro Islands adapter for Posner Lattice.
 *
 * Uses transition:persist to shield the R3F canvas from View Transition DOM swaps.
 * This preserves the WebGL2 context, GPU FBOs, and shader compilation state
 * across page navigations — critical for continuous bio-feedback regulation.
 */
import { PosnerLatticeScene } from './PosnerLatticeScene.jsx';
---

<div
  transition:persist="quantum-lattice-canvas"
  class="fixed inset-0 w-full h-full z-0 pointer-events-none"
  aria-hidden="true"
>
  <PosnerLatticeScene client:only="react" />
</div>
