    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "vite/client",
      "@webgpu/types"
    ],
    "paths": {
      "@p31/shared": [
        "../packages/shared/src"
      ],
      "@p31/shared/*": [
        "../packages/shared/src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/__tests__",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "../spaceship-earth",
    "src/components/QuantumEggHunt.js"
  ]
