{
  "_schema": "PMM_NEXUS=1.0",
  "_comment": "Cross-domain entanglement rules for the NEXUS daemon. Each rule defines how one domain's metrics affect another domain's state.",
  "entanglements": [
    {
      "id": "calcium-cognitive",
      "from_domain": "METABOLIC",
      "from_metric": "serum_calcium_mg_dL",
      "to_domain": "COGNITIVE",
      "to_metric": "spoon_budget",
      "condition": "lt",
      "threshold": 7.8,
      "effect": "cap",
      "cap_value": 3,
      "weight": 0.9,
      "description": "Hypocalcemia caps spoon budget at 3 — metabolic state constrains cognitive capacity"
    },
    {
      "id": "metabolic-entropy",
      "from_domain": "METABOLIC",
      "from_metric": "overall",
      "to_domain": "COGNITIVE",
      "to_metric": "entropy_multiplier",
      "condition": "lt",
      "threshold": 0.4,
      "effect": "multiply",
      "multiplier": 1.5,
      "weight": 0.7,
      "description": "Poor metabolic health increases cognitive entropy — everything costs more spoons"
    },
    {
