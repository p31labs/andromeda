              const err = await res.json().catch(() => ({ error: 'Unknown error' }));
              throw new Error(err.error || 'Failed to create checkout session');
            }
            const { approval_url } = await res.json();
            if (approval_url) {
              window.location.href = approval_url;
            } else {
              throw new Error('No approval URL returned');
            }
          b.classList.toggle('bg-cyan-400', isActive);
          b.classList.toggle('text-black', isActive);
          b.classList.toggle('border-cyan-400', isActive);
          b.classList.toggle('bg-gray-800', !isActive);
          b.classList.toggle('text-cyan-400', !isActive);
          b.classList.toggle('border-gray-600', !isActive);
      init();
