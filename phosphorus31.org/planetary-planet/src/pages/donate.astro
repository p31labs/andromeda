              b.classList.toggle('bg-gray-800', !active);
              b.classList.toggle('text-cyan-400', !active);
              b.classList.remove('active', 'bg-cyan-400', 'text-black', 'border-cyan-400');
              b.classList.add('bg-gray-800', 'text-cyan-400', 'border-gray-600');
          btn.textContent = 'Redirecting to PayPal...';
