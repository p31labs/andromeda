---
import PHOSRoot from '../components/PHOSRoot';
import '../styles/global.css';

// GRAY_ROCK detection: check URL params at request time
const search = Astro.url.search;
const isGrayRock = search.includes('urgent') || search.includes('grayrock') || search.includes('crisis');

// Extract surface from query for atmosphere context
const surfaceParam = search.includes('surface=')
  ? search.split('surface=')[1]?.split('&')[0]?.toUpperCase()
  : 'GREETING';
---

<!doctype html>
<html lang="en" class={isGrayRock ? 'gray-rock' : 'dark'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="PHOS — Phosphorus Human Operating Surface. Central UI character and routing mesh for the P31 Labs ecosystem." />
    <meta name="theme-color" content={isGrayRock ? '#000000' : '#0a0a0a'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Synchronous Dark Mode / Gray Rock enforcement — prevents FOUC -->
    <script is:inline>
      (function() {
        var params = new URLSearchParams(window.location.search);
        var isGrayRock = params.has('urgent') || params.has('grayrock') || params.has('crisis');

        if (isGrayRock) {
          document.documentElement.classList.add('gray-rock');
          document.documentElement.classList.remove('dark');
          document.documentElement.style.setProperty('--phos-primary', '#888888');
          document.documentElement.style.setProperty('--phos-secondary', '#666666');
          document.documentElement.style.setProperty('--phos-accent', '#555555');
          document.documentElement.style.setProperty('--phos-bg', '#000000');
          document.documentElement.style.setProperty('--phos-text', '#cccccc');
          document.documentElement.style.setProperty('--phos-muted', '#555555');
          document.documentElement.style.setProperty('--phos-motion', '0');
        } else {
          document.documentElement.classList.add('dark');
          document.documentElement.style.setProperty('--phos-primary', '#39ff14');
          document.documentElement.style.setProperty('--phos-secondary', '#00e5ff');
          document.documentElement.style.setProperty('--phos-accent', '#b026ff');
          document.documentElement.style.setProperty('--phos-bg', '#0a0a0a');
          document.documentElement.style.setProperty('--phos-text', '#e0e0e0');
          document.documentElement.style.setProperty('--phos-muted', '#666666');
          document.documentElement.style.setProperty('--phos-motion', '1');
        }

        // ---- THEME LOCK: MutationObserver defends against rogue hooks ----
        var themeLock = document.documentElement;
        var observer = new MutationObserver(function(mutations) {
          mutations.forEach(function(m) {
            if (m.attributeName === 'class') {
              var currentClass = themeLock.className;
              // If dark is gone and gray-rock is gone, force dark back
              if (currentClass.indexOf('dark') === -1 && currentClass.indexOf('gray-rock') === -1) {
                themeLock.classList.add('dark');
              }
            }
          });
        });
        observer.observe(themeLock, { attributes: true, attributeFilter: ['class'] });
      })();
    </script>

    <title>PHOS — P31 Labs Surface</title>

    <style is:global>
      /* ---- RESET & BASE ---- */
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body {
        background-color: var(--phos-bg, #0a0a0a);
        color: var(--phos-text, #e0e0e0);
        min-height: 100vh;
        overflow-x: hidden;
      }

      /* ---- GRAY ROCK OVERRIDE ---- */
      .gray-rock,
      .gray-rock body {
        background-color: #000000 !important;
        color: #cccccc !important;
      }

      .gray-rock * {
        animation: none !important;
        transition: none !important;
        box-shadow: none !important;
        text-shadow: none !important;
      }

      .gray-rock a,
      .gray-rock button,
      .gray-rock input {
        color: #888888 !important;
        border-color: #555555 !important;
      }

      .gray-rock h1,
      .gray-rock h2,
      .gray-rock h3 {
        color: #aaaaaa !important;
      }

      /* ---- CUSTOM SCROLLBAR ---- */
      ::-webkit-scrollbar {
        width: 6px;
      }
      ::-webkit-scrollbar-track {
        background: #000000;
      }
      ::-webkit-scrollbar-thumb {
        background: #333;
        border-radius: 3px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #555;
      }

      /* ---- TRANSITIONS ---- */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <!--
      PHOSRoot — single unified React island that renders
      StarfieldCanvas + PHOSShell + PHOSGuide inside AtmosphereProvider.
      transition:persist ensures the DOM node survives view transitions
      without duplication.
    -->
    <PHOSRoot
      initialSurface={surfaceParam}
      client:only="react"
      transition:persist
    />

    <!-- Page-specific content (unique per surface) goes here -->
    <slot />

    <!-- Service Worker Registration — offline boot -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js').catch(function() {
          });
        });
      }
    </script>

    <!-- View Transitions setup -->
    <script is:inline>
      if (document.startViewTransition) {
        document.documentElement.style.setProperty('view-transition-name', 'phos-main');
      }
    </script>
  </body>
</html>
