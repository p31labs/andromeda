# P31 12-Pillar MVP Template - Environment Variables
# Version: 1.0.0
# Copy this file to .env and fill in your values

# ============================================
# P31 ORGANIZATION
# ============================================

P31_ORG_NAME="P31 Labs"
P31_MVP_NAME="mvp-template"
P31_MVP_VERSION="1.0.0"

# ============================================
# DEVELOPMENT
# ============================================

NODE_ENV=development
VITE_DEV_SERVER_PORT=5173

# ============================================
# CLOUDFLARE (Required for deployment)
# ============================================

# Get these from Cloudflare dashboard
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# Worker routes
VITE_API_BASE_URL=https://mvp-template.p31ca.org

# ============================================
# DATABASE (PGLite)
# ============================================

PGLITE_DB_NAME=p31_mvp_template
PGLITE_STORAGE_TYPE=indexeddb

# ============================================
# PQC - POST-QUANTUM CRYPTOGRAPHY
# ============================================
# Generate keys using: npm run pqc:generate-keys
# NEVER commit actual secret keys to git!

# Public key (can be committed, used for verification)
PQC_PUBLIC_KEY_ML_DSA=your_ml_dsa_public_key_base64

# Secret key (NEVER commit - use wrangler secret)
# Set via: wrangler secret put PQC_SECRET_KEY
# PQC_SECRET_KEY=your_ml_dsa_secret_key_base64

# ============================================
# AUTHENTICATION
# ============================================

# JWT secret (set via wrangler secret)
# JWT_SECRET=your_jwt_secret

# API key for service-to-service (set via wrangler secret)
# API_KEY=your_api_key

# ============================================
# FEATURE FLAGS
# ============================================

VITE_ENABLE_VOICE=true
VITE_ENABLE_SYNC=true
VITE_ENABLE_ANALYTICS=false
VITE_DEBUG_MODE=false

# ============================================
# ACCESSIBILITY
# ============================================

# Default accessibility settings
DEFAULT_TOUCH_TARGET=standard
DEFAULT_FONT_SIZE=normal
DEFAULT_CONTRAST=standard
DEFAULT_MOTION=full

# ============================================
# TELEMETRY (Optional)
# ============================================

# Set to true to enable anonymous usage analytics
P31_TELEMETRY_ENABLED=false
P31_TELEMETRY_ENDPOINT=

# ============================================
# THIRD-PARTY SERVICES (Optional)
# ============================================

# Sentry for error tracking (optional)
# SENTRY_DSN=your_sentry_dsn

# Analytics (optional)
# ANALYTICS_ID=your_analytics_id

# ============================================
# LOCAL DEVELOPMENT ONLY
# ============================================

# Skip PQC verification in development (for testing)
SKIP_PQC_VERIFY=false

# Enable detailed logging
DEBUG_LOGS=true
